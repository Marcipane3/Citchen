{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node v2/tests/run.js)",
      "Bash(node v2/tools/check-snapshots.mjs*)",
      "Bash(npm --prefix v2/e2e *)",
      "Bash(npx --prefix v2/e2e *)",
      "Bash(bash supabase/tests/run.sh)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push -u origin build/*)",
      "Bash(git push -u origin release-bump/*)",
      "Bash(gh api repos/Marcipane3/Citchen/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin next*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:next*)",
      "Bash(supabase *)",
      "Bash(npx supabase*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
